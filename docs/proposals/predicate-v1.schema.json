{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nauman/predicate/blob/main/docs/proposals/predicate-v1.schema.json",
  "title": "predicate/v1 rule document (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "facts",
    "condition"
  ],
  "properties": {
    "schema": {
      "const": "predicate/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/fact"
      }
    },
    "condition": {
      "$ref": "#/$defs/node"
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "boolean",
            "integer",
            "number",
            "string",
            "date"
          ]
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "factName": {
      "type": "string",
      "minLength": 1
    },
    "literal": {
      "type": [
        "boolean",
        "number",
        "string"
      ]
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/group"
        },
        {
          "$ref": "#/$defs/negation"
        },
        {
          "$ref": "#/$defs/comparison"
        },
        {
          "$ref": "#/$defs/membership"
        },
        {
          "$ref": "#/$defs/presence"
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "properties": {
        "op": {
          "enum": [
            "all",
            "any"
          ]
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "negation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "arg"
      ],
      "properties": {
        "op": {
          "const": "not"
        },
        "arg": {
          "$ref": "#/$defs/node"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "fact",
        "value"
      ],
      "properties": {
        "op": {
          "enum": [
            "eq",
            "ne",
            "gt",
            "gte",
            "lt",
            "lte"
          ]
        },
        "fact": {
          "$ref": "#/$defs/factName"
        },
        "value": {
          "$ref": "#/$defs/literal"
        }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "fact",
        "values"
      ],
      "properties": {
        "op": {
          "const": "in"
        },
        "fact": {
          "$ref": "#/$defs/factName"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/literal"
          }
        }
      }
    },
    "presence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "fact"
      ],
      "properties": {
        "op": {
          "const": "unanswered"
        },
        "fact": {
          "$ref": "#/$defs/factName"
        }
      }
    }
  }
}
