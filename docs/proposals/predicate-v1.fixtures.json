{
  "note": "Draft acceptance fixtures for predicate/v1. Any implementation (Ruby, browser) must produce these statuses and error codes.",
  "rule": {
    "schema": "predicate/v1",
    "id": "leave.requires_hr",
    "revision": 1,
    "facts": {
      "working_days": { "type": "integer" },
      "employment": { "type": "string" }
    },
    "condition": {
      "op": "all",
      "args": [
        { "op": "gt", "fact": "working_days", "value": 10 },
        { "op": "not", "arg": { "op": "in", "fact": "employment", "values": ["contractor", "intern"] } }
      ]
    }
  },
  "evaluations": [
    { "facts": { "working_days": 12, "employment": "permanent" }, "status": "matched" },
    { "facts": { "working_days": 10, "employment": "permanent" }, "status": "not_matched" },
    { "facts": { "working_days": 12, "employment": "intern" }, "status": "not_matched" },
    { "facts": { "working_days": 12, "employment": "permanent", "team": "ops" }, "status": "matched" },
    { "facts": { "employment": "permanent" }, "status": "failed", "errors": ["fact_missing"] },
    { "facts": { "working_days": null, "employment": "permanent" }, "status": "failed", "errors": ["fact_missing"] },
    { "facts": { "working_days": "12", "employment": "permanent" }, "status": "failed", "errors": ["fact_type_mismatch"] },
    { "facts": { "working_days": 12.5, "employment": "permanent" }, "status": "failed", "errors": ["fact_type_mismatch"] },
    { "facts": { "working_days": 3 }, "status": "failed", "errors": ["fact_missing"] },
    { "facts": { "working_days": "x", "employment": 7 }, "status": "failed", "errors": ["fact_type_mismatch", "fact_type_mismatch"] }
  ],
  "invalid_documents": [
    { "why": "unknown top-level key", "code": "invalid_document",
      "document": { "schema": "predicate/v1", "id": "a", "revision": 1, "facts": { "x": { "type": "integer" } }, "condition": { "op": "gt", "fact": "x", "value": 1 }, "rule": {} } },
    { "why": "unknown operator", "code": "invalid_document",
      "document": { "schema": "predicate/v1", "id": "a", "revision": 1, "facts": { "x": { "type": "integer" } }, "condition": { "op": "matches", "fact": "x", "value": 1 } } },
    { "why": "alias spelling (field/operator) is not accepted", "code": "invalid_document",
      "document": { "schema": "predicate/v1", "id": "a", "revision": 1, "facts": { "x": { "type": "integer" } }, "condition": { "operator": "gt", "field": "x", "value": 1 } } },
    { "why": "unsupported schema version", "code": "unsupported_schema",
      "document": { "schema": "predicate/v2", "id": "a", "revision": 1, "facts": { "x": { "type": "integer" } }, "condition": { "op": "gt", "fact": "x", "value": 1 } } },
    { "why": "fact not declared (semantic check)", "code": "undeclared_fact",
      "document": { "schema": "predicate/v1", "id": "a", "revision": 1, "facts": { "x": { "type": "integer" } }, "condition": { "op": "gt", "fact": "y", "value": 1 } } },
    { "why": "declared fact never used (semantic check)", "code": "unused_fact",
      "document": { "schema": "predicate/v1", "id": "a", "revision": 1, "facts": { "x": { "type": "integer" }, "y": { "type": "string" } }, "condition": { "op": "gt", "fact": "x", "value": 1 } } },
    { "why": "literal type differs from fact type (semantic check)", "code": "value_type_mismatch",
      "document": { "schema": "predicate/v1", "id": "a", "revision": 1, "facts": { "x": { "type": "integer" } }, "condition": { "op": "gt", "fact": "x", "value": "10" } } },
    { "why": "ordering operator on a string fact (semantic check)", "code": "operator_not_allowed",
      "document": { "schema": "predicate/v1", "id": "a", "revision": 1, "facts": { "x": { "type": "string" } }, "condition": { "op": "gt", "fact": "x", "value": "a" } } }
  ]
}
